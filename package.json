{
  "name": "em-os",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "biome check .",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "ci": "npm run lint && npm run check:fixtures && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  }
}
